# .env.example
# 実際の値は Netlify の「Site settings > Environment variables」に登録し、
# このファイル自体（本物の値入り）はGitにコミットしないこと。

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service role keyはNetlify Functions（サーバー側）専用。フロントエンドに絶対に渡さない。
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_LIGHT=
STRIPE_PRICE_ID_STANDARD=
STRIPE_PRICE_ID_PRO=

# --- アプリ設定 ---
PUBLIC_APP_URL=https://app.example.com
ATTENDANCE_QR_TTL_SECONDS=30

# --- ブランディング（後から変更可能な設定として、DBのstore設定 or 環境変数どちらに置くか実装時に決定） ---
PUBLIC_SERVICE_NAME=よるラク
PUBLIC_SUPPORT_EMAIL=
